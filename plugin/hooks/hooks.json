{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "treeproof hook PostToolUse",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
